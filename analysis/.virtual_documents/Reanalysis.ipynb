def get_topic_preference_rank(row):

    if row["Topic"] == row["topic_preference_1"]:
        return 1

    elif row["Topic"] == row["topic_preference_2"]:
        return 2

    elif row["Topic"] == row["topic_preference_3"]:
        return 3

    else:
        return np.nan


