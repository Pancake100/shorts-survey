def interpret_correlation(r):

    absolute_r = abs(r)

    if absolute_r < 0.10:
        return "Negligible"

    elif absolute_r < 0.30:
        return "Weak"

    elif absolute_r < 0.50:
        return "Moderate"

    elif absolute_r < 0.70:
        return "Strong"

    else:
        return "Very strong"


correlation_results[
