    if len(plot_data) < 3:
        continue

    x = plot_data[kansei_column]
    y = plot_data["PS"]

    slope, intercept, _, _, _ = (
        stats.linregress(x, y)
    )

    x_line = np.linspace(
        x.min(),
        x.max(),
        100
    )

    y_line = intercept + slope * x_line

    plt.figure(figsize=(8, 5))

    plt.scatter(
        x,
        y,
        s=65
    )

    plt.plot(
        x_line,
        y_line,
        linestyle="--"
    )

    plt.axvline(
        x=0,
        linestyle=":",
        linewidth=1
    )

    plt.axhline(
