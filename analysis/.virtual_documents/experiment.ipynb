# Create topic-specific preference score
# 3 = first preference
# 2 = second preference
# 1 = third preference

def normalize_topic(x):
    if pd.isna(x):
        return np.nan

    x = str(x).strip().lower()

    mapping = {
        "language_learning": "Language",
        "language": "Language",
        "science": "Science",
        "history": "History"
    }

    return mapping.get(x, x)


for col in [
    "topic_preference_1",
    "topic_preference_2",
    "topic_preference_3"
]:
    participant_analysis[col + "_clean"] = (
        participant_analysis[col]
        .apply(normalize_topic)
    )


def get_topic_preference(row, topic):
    if row["topic_preference_1_clean"] == topic:
        return 3
    elif row["topic_preference_2_clean"] == topic:
        return 2
    elif row["topic_preference_3_clean"] == topic:
        return 1
    else:
        return np.nan


preference_rows = []

for _, row in participant_analysis.iterrows():
    for topic in ["Language", "Science", "History"]:
        preference_rows.append({
            "participant_id": row["participant_id"],
            "Topic": topic,
            "Topic_Preference": get_topic_preference(
                row,
                topic
            )
