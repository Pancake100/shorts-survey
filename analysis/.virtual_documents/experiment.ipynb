valid_mask = (
    kansei_ps_correlations[
        "Spearman p-value"
    ].notna()
)

kansei_ps_correlations[
    "Adjusted p-value"
] = np.nan

kansei_ps_correlations[
    "Significant"
] = False

if valid_mask.sum() > 0:

    reject, adjusted_p, _, _ = (
        multipletests(
            kansei_ps_correlations.loc[
                valid_mask,
                "Spearman p-value"
            ],
            alpha=0.05,
            method="holm"
        )
    )

    kansei_ps_correlations.loc[
        valid_mask,
        "Adjusted p-value"
    ] = adjusted_p

    kansei_ps_correlations.loc[
        valid_mask,
        "Significant"
    ] = reject

