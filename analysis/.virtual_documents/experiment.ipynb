sensitivity_data["Visual_Content_z"] = zscore(
    sensitivity_data["Visual_Content_Factor"]
)

sensitivity_data["Audio_Narrator_z"] = zscore(
    sensitivity_data["Audio_Narrator_Factor"]
)

print(
    sensitivity_data[
        ["Visual_Content_z", "Audio_Narrator_z"]
    ].describe().round(3)
)


participant_var = control_result.vcomp[0]
video_var = control_result.vcomp[1]
residual_var = control_result.scale

print("Participant variance:", participant_var)
print("Video variance:", video_var)
print("Residual variance:", residual_var)


import numpy as np
import statsmodels.formula.api as smf

def simulate_power(beta,
                   n_sim=100,
                   alpha=0.05,
                   seed=1234):

    rng = np.random.default_rng(seed)

    significant = 0
    successful = 0

    data = sensitivity_data.copy()

    participants = data["participant_id"].unique()
    videos = data["video_id_count"].unique()

    for i in range(n_sim):

        # Random participant effects
        participant_effects = {
            p: rng.normal(
                0,
                np.sqrt(participant_var)
            )
            for p in participants
        }

        # Random video effects
        video_effects = {
            v: rng.normal(
                0,
                np.sqrt(video_var)
            )
            for v in videos
        }

        # Residual error
        error = rng.normal(
            0,
            np.sqrt(residual_var),
            size=len(data)
        )

        # Simulated outcome
        y_sim = (
            3.3
            + beta * data["Visual_Content_z"]
            + 0.0 * data["Audio_Narrator_z"]
            + data["participant_id"].map(
                participant_effects
            )
            + data["video_id_count"].map(
                video_effects
            )
            + error
        )

        sim_data = data.copy()
        sim_data["y_sim"] = y_sim
        sim_data["all_group"] = 1

        try:
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")

                sim_model = smf.mixedlm(
                    formula=(
                        "y_sim ~ "
                        "Visual_Content_z + "
                        "C(Topic) + "
                        "C(group)"
                    ),
                    data=sim_data,
                    groups=sim_data["all_group"],
                    re_formula="0",
                    vc_formula={
                        "Participant":
                            "0 + C(participant_id)",
                        "Video":
                            "0 + C(video_id_count)"
                    }
                )

                sim_result = sim_model.fit(
                    reml=True,
                    method="powell",
                    maxiter=2000,
                    disp=False
                )

            if sim_result.converged:
                successful += 1

                p_value = sim_result.pvalues[
                    "Visual_Content_z"
                ]

                if p_value < alpha:
                    significant += 1

        except:
            pass

    if successful == 0:
        return np.nan

    return significant / successful


effect_sizes = [
    0.10,
    0.20,
    0.30,
    0.40,
    0.50,
    0.60
]

power_results = []

for beta in effect_sizes:

    power = simulate_power(
        beta=beta,
        n_sim=100
    )

    power_results.append({
        "Effect_per_1SD": beta,
        "Estimated_Power": power
    })

    print(
        "Effect:",
        beta,
        "| Power:",
        round(power, 3)
    )

power_table = pd.DataFrame(power_results)

display(power_table)


